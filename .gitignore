# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Derived data — regenerated by the pipeline on every run.
#
# These are outputs, not sources. Committing them weekly would grow the repo
# without adding anything you cannot rebuild in one command.
#   out/premiums_long.csv is ~10 MB and is rewritten on every refresh.
# ---------------------------------------------------------------------------
out/

# Raw JSON downloaded by refresh.py --pull. Rebuilt from vhis.gov.hk on demand,
# and each copy is ~5 MB.
current/

# Local copies of the four source files, if you drop them in the repo root
# while testing instead of letting refresh.py fetch them.
/standard-plans.json
/flexi-plans.json
/plan-premium.json
/plan-premium.zip
/psi-registered-providers.json

# ---------------------------------------------------------------------------
# PDF cache — ~39 MB for 40 plans, so roughly 560 MB for all 579.
# Re-downloadable from the insurers at any time. Never commit this.
# ---------------------------------------------------------------------------
pdf_cache/
txt_cache/

# ---------------------------------------------------------------------------
# verify_workbook.py --keep leaves a recalculated copy behind
# ---------------------------------------------------------------------------
*.recalc.xlsx

# Staging file the scraper writes before the merge step folds it into
# data/plan_benefits.csv. Committing it just duplicates ~190 KB and invites
# someone to edit the copy that gets overwritten on the next run.
data/plan_benefits_new.csv

# Excel lock files, created when the workbook is open
~$*.xlsx
.~lock.*#

# Full dated copies of the source JSON, written only by `refresh.py --snapshot`.
# The change report does NOT need these: it diffs against data/plan_state.json,
# which holds the same information the diff actually reads in ~60 KB instead of
# ~5 MB per run. Keep them locally if you want an audit trail; committing them
# would add roughly 260 MB a year for nothing.
snapshots/

# ---------------------------------------------------------------------------
# DELIBERATELY NOT IGNORED — these must stay in git or the pipeline breaks:
#
#   vhis_state.db              SHA-256 hashes from the last run. Without it,
#                              every CI run thinks all four files are NEW and
#                              re-scrapes all 579 PDFs.
#   data/plan_state.json       reduced prior-week state. Without it the change
#                              report has nothing to diff against.
#   data/plan_benefits.csv     accumulated PDF scrape results (~40 min to rebuild).
#   data/manual_overrides.csv  hand-entered corrections. Irreplaceable.
#   VHIS_Compare.xlsx          the workbook the GitHub Action publishes.
# ---------------------------------------------------------------------------

# worklist.py keeps one backup of the overrides file before rewriting it
data/manual_overrides.csv.bak
